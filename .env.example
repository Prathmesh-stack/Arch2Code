# Arch2Code AI — copy to .env and fill in what you need.
# The server runs fine with no .env at all (demo mode).

# --- AI provider (optional) -------------------------------------------------
# Without a key the app uses the deterministic demo generator and says so in the UI.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Demo safety ------------------------------------------------------------
# DEMO_MODE=1 forces the deterministic generator even when a key is configured.
DEMO_MODE=0
# AI_FALLBACK=off returns HTTP 502 on provider errors instead of a labeled demo proposal.
AI_FALLBACK=on
# Max AI requests per IP per 5 minutes (default 12).
AI_RATE_LIMIT=12

# --- Server -----------------------------------------------------------------
PORT=8787
# Where projects/generations are stored. Defaults to ./data
# ARCH2CODE_DATA_DIR=./data
